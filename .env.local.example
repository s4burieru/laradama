# Copy this file to `.env.local` (same folder) and fill it in.
# Vite only reads env files at startup, so restart `npm run dev` afterwards.
# `.env.local` is git-ignored by the `*.local` rule; this template is not.
#
# Get a free key: https://aistudio.google.com/apikey
# Treat any key you paste anywhere public as leaked — revoke and make a new one.
GEMINI_API_KEY=

# Optional — only needed if you want Spotify links resolved through your own
# app credentials; the app works without them (iTunes previews still play).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
